    "@types/tough-cookie": "^4.0.5",
    "dotenv": "^17.4.2",
    "eslint": "^9.38.0",
    "eslint-config-next": "^15.5.20",
    "pg": "^8.22.0",
    "prettier": "^3.9.5",
    "shadcn": "^4.13.0",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2"
  },
  "optionalDependencies": {
    "rebrowser-playwright": "^1.52.0"
  },
  "overrides": {
    "postcss": "^8.5.14",
    "@prisma/dev": {
      "@hono/node-server": "^1.19.13"
    }
  }
}
