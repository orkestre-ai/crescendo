# ============================================================================
# DATABASE
# ============================================================================

# Docker Compose users: DB connection strings are overridden automatically
# by docker-compose.yml — no changes needed for the values below.

# Docker PostgreSQL (recommended for local development)
# These values match the docker-compose.yml configuration
# Run: docker-compose up -d
POSTGRES_URL="postgresql://postgres:postgres@localhost:54320/crescendo"
POSTGRES_PRISMA_URL="postgresql://postgres:postgres@localhost:54320/crescendo?pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://postgres:postgres@localhost:54320/crescendo"

# Dedicated DB URL for integration tests in npm run test:ai-tools.
# Must point to a database that can be freely truncated.
POSTGRES_TEST_URL="postgresql://postgres:postgres@localhost:54320/crescendo_test?schema=public"

# ============================================================================
# ENGAGING NETWORKS API
# ============================================================================

EN_API_TOKEN="your_engaging_networks_api_token"
EN_BASE_URL="https://ca.engagingnetworks.app/ens/service"

# Regional Options:
# - Canada: https://ca.engagingnetworks.app/ens/service
# - US: https://us.e-activist.com/ens/service
# - Europe: https://eu.engagingnetworks.app/ens/service
# - Australia: https://au.engagingnetworks.app/ens/service
#
# Check your EN admin panel URL to determine your region
# See docs/ENS-API.md for detailed API documentation

# Get your token from:
# 1. Log into Engaging Networks admin
# 2. Navigate to Settings → API
# 3. Generate or copy your API token

# ============================================================================
# GOOGLE ANALYTICS 4
# ============================================================================

GA4_PROPERTY_ID="properties/123456789"

# Service account credentials (JSON format - entire JSON as one line)
GA4_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}'

# Setup instructions:
# 1. Go to Google Cloud Console (console.cloud.google.com)
# 2. Create a new project or select existing
# 3. Enable Google Analytics Data API
# 4. Create Service Account (IAM → Service Accounts → Create)
# 5. Download JSON key file
# 6. Copy entire JSON content as one line to GA4_SERVICE_ACCOUNT_KEY
# 7. Add service account email to GA4 property with Viewer role
# 8. Note your GA4 Property ID from GA4 admin (Admin → Property Settings)

# ============================================================================
# ANTHROPIC CLAUDE API
# ============================================================================

ANTHROPIC_API_KEY="sk-ant-api03-..."

# Get your API key from:
# https://console.anthropic.com/settings/keys

# ============================================================================
# APP CONFIGURATION
# ============================================================================

# Public URL (for absolute URLs in emails/API responses)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cron secret (optional — only needed for external cron triggering via curl)
CRON_SECRET="your_random_secret_here"

# Node environment
NODE_ENV="development"

# ============================================================================
# ENCRYPTION
# ============================================================================

# 32-byte encryption key for secure API key storage (required for Settings page)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="your_64_character_hex_key_here"

# ============================================================================
# OPTIONAL CONFIGURATION
# ============================================================================

# Screenshot storage directory (defaults to public/screenshots)
# SCREENSHOT_DIR="/path/to/screenshots"

# Disable in-process scheduler (defaults to true)
# ENABLE_SCHEDULER="false"

# ============================================================================
# DEBUG / DEVELOPMENT
# ============================================================================

# Limit sync to N most-recently-modified live pages (0 = no limit)
# Useful for testing sync flow without processing all 239 pages
# SYNC_DEBUG_LIMIT=10

# ============================================================================
# STEALTH SCRAPING (optional)
# ============================================================================

# Use rebrowser-playwright instead of vanilla Playwright for scraping
# Patches CDP leaks to avoid Cloudflare bot detection
# Requires: npm install rebrowser-playwright
# REBROWSER_ENABLED="true"

# Webshare proxy for residential IP rotation (all 4 required if any is set)
# Sign up at webshare.io — use residential proxies for best Cloudflare bypass
# WEBSHARE_PROXY_HOST="p.webshare.io"
# WEBSHARE_PROXY_PORT="80"
# WEBSHARE_PROXY_USER="your_webshare_username"
# WEBSHARE_PROXY_PASS="your_webshare_password"

# Trace-diff verification harness (sub-project 1 — jobs.ts split)
# A dedicated Postgres DB used ONLY by src/scripts/capture-trace.ts.
# Never set this equal to POSTGRES_URL.
TRACE_DATABASE_URL=postgresql://postgres:postgres@localhost:54320/crescendo_trace
