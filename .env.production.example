# ============================================================================
# Crescendo production .env (docker-compose.prod.yml)
# ============================================================================
#
# Copy to .env next to docker-compose.yml, then `chmod 600 .env`.
# Compose reads this file twice: for ${VAR} interpolation in the compose files,
# and as the app container's env_file. Generate secrets on the server and keep
# a copy in your password manager; never commit the filled-in file.
#
# Deploy: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
# Runbook: docs/guides/digitalocean-deploy.md

# ============================================================================
# REQUIRED
# ============================================================================

# Database password. Generate: openssl rand -hex 32
# Hex only, because it is embedded in the postgresql:// connection URLs.
#
# WARNING: Postgres only reads this when the postgres_data volume is first
# initialised. Changing it later does NOT change the database password; run
#   docker exec -it crescendo-db psql -U postgres -c "ALTER USER postgres PASSWORD '<new>'"
# first, then update this file and redeploy.
POSTGRES_PASSWORD=

# Cloudflare Tunnel token (Zero Trust -> Networks -> Tunnels -> your tunnel).
# The tunnel's public hostname should point at http://app:3000.
CLOUDFLARE_TUNNEL_TOKEN=

# Key for API credentials stored from the Settings page: 64 hex characters.
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# Guards the manual /api/cron/* triggers (the in-process scheduler needs no
# external cron). At least 16 characters. Generate: openssl rand -base64 36
CRON_SECRET=

# The public HTTPS hostname users reach (behind Cloudflare Access).
NEXT_PUBLIC_APP_URL=https://crescendo.example.com

# ============================================================================
# ENGAGING NETWORKS
# ============================================================================

# REST API token for an API user whose IP allow list contains this server's
# outbound IPv4. A 401/403 usually means the IP changed, not the token.
EN_API_TOKEN=
# REST API endpoint and Public API region; set both for the account's data centre.
#   Canada: EN_BASE_URL=https://ca.engagingnetworks.app/ens/service  EN_REGION=ca
#   US:     EN_BASE_URL=https://us.e-activist.com/ens/service         EN_REGION=us
EN_BASE_URL=https://ca.engagingnetworks.app/ens/service
EN_REGION=ca

# Optional: Public API token for NetDonor fundraising data.
# EN_PUBLIC_TOKEN=

# ============================================================================
# GOOGLE ANALYTICS 4
# ============================================================================

GA4_PROPERTY_ID=properties/123456789
# Service account JSON on ONE line, in single quotes.
GA4_SERVICE_ACCOUNT_KEY='{"type":"service_account", ...}'

# ============================================================================
# ANTHROPIC (optional, for AI recommendations)
# ============================================================================

# DEEP scans call Claude for every page; set a spend limit on this key.
# ANTHROPIC_API_KEY=sk-ant-...
